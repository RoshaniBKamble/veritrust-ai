# ============================================================
# VeriTrust AI — repository hygiene
# ============================================================

# ---- Secrets & environment (never commit) ----
.env
.env.*
!.env.example
!**/.env.example
*.env
credentials.json
*credentials.json*
*token.json*
.credentials
*.key
*.pem
*.p12
*.pfx
id_rsa*

# ---- Internal development-workspace artifacts (not part of the application) ----
.emergent/
memory/
test_reports/
test_result.md
design_guidelines.json
/tests/
/scripts/
/.gitconfig
/yarn.lock
backend/tests/
backend/pytest.ini
.ruff_cache/

# ---- Local database cluster & runtime data ----
pgdata/
pglogs/
backend/ipfs_store/
backend/uploads/
*.sql.gz
dump.rdb

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
venv/
.venv/
env/
*.egg-info/

# ---- Node / frontend ----
node_modules/
/frontend/build/
/frontend/dist/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/install-state.gz
.pnp.js
/.pnp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# ---- Blockchain tooling ----
blockchain/node_modules/
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/

# ---- Build / caches / coverage ----
dist/
build/
coverage/
.cache/
*.tsbuildinfo

# ---- IDE / editor / OS ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Deployment tooling ----
.vercel
.netlify

# ---- Archives & large binaries ----
*.zip
*.tar
*.tar.gz
*.tgz
*.pack
*.deb
*.dylib
frontend/node_modules/.cache/default-development/0.pack
frontend/node_modules/.cache/default-development/1.pack
