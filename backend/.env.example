# ---- Backend (FastAPI) ----
# PostgreSQL connection (SQLAlchemy async + asyncpg)
DATABASE_URL="postgresql+asyncpg://veritrust:veritrust_pass@localhost:5432/veritrust_db"

# JWT signing secret (generate a strong random 64-char hex string)
JWT_SECRET="change-me-to-a-long-random-hex-secret"

# Emergent Universal LLM key (Claude / OpenAI / Gemini). Get from Emergent profile.
EMERGENT_LLM_KEY="sk-emergent-xxxxxxxxxxxxxxxxx"

# Local IPFS-compatible object store + uploads
IPFS_STORAGE_DIR="/app/backend/ipfs_store"
UPLOAD_DIR="/app/backend/uploads"

# CORS (comma-separated origins; avoid '*' in production with credentials)
CORS_ORIGINS="http://localhost:3000"

# ---- Optional: go live on Polygon Amoy ----
# When BOTH CONTRACT_ADDRESS and AMOY_RPC_URL are set the UI labels records "Live on-chain";
# otherwise everything is clearly labelled "Simulated ledger · dev mode".
# CONTRACT_ADDRESS="0x..."          # deployed DocumentVerification address
# AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
# BLOCKCHAIN_PRIVATE_KEY="0x..."    # NEVER commit a real key
